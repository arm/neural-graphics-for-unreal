#include "/Engine/Private/Common.ush"
#include "/Engine/Private/ScreenPass.ush"
#include "/Plugin/NG/Private/NGConvertVelocityCommon.ush"



// =====================================================================================
//
// SHADER RESOURCES
//
// =====================================================================================
Texture2D InputDepth;
Texture2D InputVelocity;
int2 ContentSize;
float2 InvContentSize;
float2 InvOutputExtent;

float2 main(float4 SvPosition : SV_POSITION) : SV_Target0
{
    FNGConvertVelocitySample Sample = ConvertVelocityAtOutputPixel(
        InputDepth,
        InputVelocity,
        uint2(SvPosition.xy),
        int2(0, 0),
        float2(ContentSize),
        InvContentSize,
        InvOutputExtent);

    return ConvertVelocityToOutputSpace(Sample.Velocity);
}
